# Copy to .env. Local-only development defaults; no secrets required.
DATABASE_PATH=./jansuno.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional, used only if frontend is served on an alternate port:
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000
